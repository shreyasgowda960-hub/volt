volt-backend/secrets/
*-service-account.json

# Firebase client config — per-app, regenerated by `flutterfire configure`
**/google-services.json
**/GoogleService-Info.plist

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node / React
node_modules/

# Editors / OS
.idea/
.DS_Store
Thumbs.db
