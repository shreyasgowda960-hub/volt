<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For the "use my current location" button in the address picker. Both
         are declared per geolocator 14.0.3's README: when both are present
         the plugin uses FINE, but declaring COARSE too means Android 12+
         users who pick "approximate location" still get a usable position
         instead of a denial.

         Deliberately NOT ACCESS_BACKGROUND_LOCATION: the position is read
         once, while the customer is looking at the map and has just tapped a
         button. Background location is a Play Store review problem and we
         have no use for it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application
        android:label="customer_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Maps SDK for Android reads the key from here; there is no way to
             inject it at runtime the way API_BASE_URL is, because the native
             SDK reads the manifest before any Dart runs.

             Committed rather than kept out of the repo, and this is the same
             value that already sits in google-services.json — so it adds no
             new exposure. It is a client identifier, not a secret: it is
             restricted to this package name plus our signing SHA-1, it ships
             inside every APK regardless, and Google rejects it for the
             Places and Geocoding web services (verified: REQUEST_DENIED,
             "not authorized... with empty referer"). That rejection is
             exactly why those two go through our backend instead.

             Same reasoning as the deliberate decision to track
             google-services.json — do not add an ignore rule for it. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDe37ttlPO3MC8bz9P2ztN5o4uQrZZgB-M" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher needs this to see the dialler. Without it
             canLaunchUrl('tel:...') returns false on Android 11 (API 30) and
             above, and the Call button on the booking status screen silently
             does nothing. Added inside the existing <queries> element on
             purpose — the manifest takes one, as a direct child of <manifest>.
             Form taken from url_launcher 6.3.2's README, not from memory. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
