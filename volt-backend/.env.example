# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/volt_dev
ENVIRONMENT=development
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# --- Service area ---------------------------------------------------------
# Deliberately configurable so the serviceable area can be narrowed for a
# field test straight from the Render dashboard, with no deploy and no app
# rebuild. Both apps fetch these from GET /api/v1/service-area.
# The defaults below are already correct for Bengaluru — leave them unset
# unless you are actually overriding them.
# SERVICE_CENTER_LAT=12.9716
# SERVICE_CENTER_LNG=77.5946
# SERVICE_RADIUS_KM=25.0

# --- Google Maps Platform -------------------------------------------------
# Server-side key for the Places and Geocoding proxy endpoints. Required for
# address search and pin drop; everything else works without it.
# Set application restriction to NONE, API restrictions to Places API (New)
# and Geocoding API only, and a daily quota cap on both.
GOOGLE_MAPS_API_KEY=

# --- Admin document review (spec 017) -------------------------------------
# Shared secret protecting GET /api/v1/admin/drivers/pending and the
# approve/reject endpoints. Sent as the X-Admin-Token header.
#
# INTERIM AND WEAK: no audit trail (every action is "whoever had the token")
# and no per-person revocation. Replaced by real admin auth when the React
# dashboard arrives, or as soon as a second person reviews documents.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset means the review endpoints answer 503, not that they are open.
ADMIN_REVIEW_TOKEN=

# Firebase Storage bucket for driver documents (spec 017). REQUIRED — the
# process refuses to start without it, because a missing bucket only shows up
# when a driver presses Upload. Copy the exact name from the Firebase console;
# it is NOT derived from the project id.
FIREBASE_STORAGE_BUCKET=volt-2b36f.firebasestorage.app
